<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.video.leanback" name="Leanback" version="0.2.6" provider-name="anxdpanic">
    <requires>
        <import addon="xbmc.python" version="3.0.1"/>
        <import addon="inputstream.adaptive" version="21.0.0"/>
    </requires>
    <extension point="xbmc.python.pluginsource" library="default.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.python.script" library="tv.py">
        <provides>executable</provides>
    </extension>
    <extension point="xbmc.service" library="service.py"/>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">Browse and watch YouTube with the TV layout</summary>
        <description lang="en_GB">Browse YouTube the way the TV app shows it: the TV sidebar, shelves, subscriptions, library and search, with full video information and DASH/HLS playback through InputStream Adaptive. Sign in with a TV code, customise the main menu, hide Shorts or watched videos, and set preferred quality, codec and subtitle languages.</description>
        <platform>all</platform>
        <license>GPL-3.0-only</license>
        <source>https://gitea.panicked.xyz/anxdpanic/youtube_tv_addon</source>
        <assets>
            <icon>resources/media/icon.png</icon>
            <fanart>resources/media/fanart.jpg</fanart>
        </assets>
        <reuselanguageinvoker>false</reuselanguageinvoker>
    </extension>
</addon>
