                </setting>
                <setting id="subs_more" type="string" label="30033">
                    <level>1</level>
                    <default></default>
                    <constraints>
                        <allowempty>true</allowempty>
                    </constraints>
                    <control type="edit" format="string">
                        <heading>30033</heading>
                    </control>
                </setting>
            </group>
        </category>
